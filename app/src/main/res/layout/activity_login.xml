<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/backgroundcolor"
    tools:context="com.sysnova.cbfdailyproductionapp.Activity.Login">

    <LinearLayout
        android:layout_marginTop="50dp"
        android:orientation="vertical"
        android:padding="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_gravity="center"
            android:src="@drawable/kfg_logo"
            android:layout_width="400dp"
            android:layout_height="150dp">

        </ImageView>

        <LinearLayout
            android:orientation="vertical"
            android:padding="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <EditText
                android:id="@+id/employeeID_editText"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:layout_below="@+id/logo"
                android:hint="User Name"
                android:backgroundTint="@color/bluegrey"
                android:textColor="@color/brac_black"
                android:textColorHint="#6a7170"
                android:textColorLink="#6a7170"
                android:drawableLeft="@drawable/account"
                android:drawablePadding="10dp"
                android:ems="10"
                />

            <EditText
                android:id="@+id/password_editText"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/employeeID_editText"
                android:layout_marginTop="20dp"
                android:hint="Password"
                android:inputType="textPassword"
                android:backgroundTint="@color/bluegrey"
                android:textColor="@color/brac_black"
                android:textColorHint="#6a7170"
                android:textColorLink="#6a7170"
                android:drawableLeft="@drawable/key"
                android:drawablePadding="10dp"
                android:ems="10"
                />

            <CheckBox
                android:id="@+id/remember_checkbox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Remember me"
                android:textColor="@color/bluegrey"
                android:shadowColor="@android:color/black"
                android:buttonTint="@color/bluegrey"
                />

            <Button
                android:layout_gravity="center"
                android:id="@+id/login_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:backgroundTint="@color/bluegrey"
                android:padding="15dp"
                android:text="LogIn"
                android:textStyle="bold"
                android:textSize="20dp"
                android:textColor="@color/white"></Button>
        </LinearLayout>
        <LinearLayout
            xmlns:android="http://schemas.android.com/apk/res/android"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                android:text="@string/app_version"
                android:textStyle="bold"
                android:textColor="@color/kfg_orange"
                android:textSize="12sp"></TextView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="@string/sysnova"
                android:textStyle="bold"
                android:textColor="@color/bluegrey"
                android:textSize="12sp"></TextView>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>