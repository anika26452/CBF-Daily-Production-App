<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    tools:context=".Activity.GeoLocationCollection">

    <LinearLayout
        android:layout_width="match_parent"
        android:orientation="vertical"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="100"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:paddingTop="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_weight="35"
                android:text="Farmer's Code"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_gravity="center"
                android:textColor="@color/kfg_orange"
                android:layout_height="wrap_content" />

            <TextView
                android:layout_width="0dp"
                android:layout_weight="5"
                android:text=":"
                android:textSize="15sp"
                android:textStyle="bold"
                android:gravity="center"
                android:textColor="@color/kfg_orange"
                android:layout_height="match_parent" />

            <EditText
                android:id="@+id/code_id"
                android:layout_width="0dp"
                android:layout_weight="50"
                android:textSize="15sp"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/black"
                android:textColor="@android:color/black">

            </EditText>

            <ImageView
                android:layout_weight="12"
                android:id="@+id/fcode_btnvw"
                android:onClick="loadfarmer"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:layout_width="20dp"
                android:layout_gravity="center"
                android:layout_height="35dp"
                android:src="@drawable/send">
            </ImageView>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="100"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:paddingTop="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_weight="35"
                android:text="Farmer's Name"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_gravity="center"
                android:textColor="@color/kfg_orange"
                android:layout_height="wrap_content" />
            <TextView
                android:layout_width="0dp"
                android:layout_weight="5"
                android:text=":"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_gravity="center"
                android:textColor="@color/kfg_orange"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/farmers_name"
                android:layout_width="0dp"
                android:layout_weight="60"
                android:text=""
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_gravity="center"
                android:textColor="@color/black"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="100"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:paddingTop="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_weight="35"
                android:text="Farmer's Address"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_gravity="center"
                android:textColor="@color/kfg_orange"
                android:layout_height="wrap_content" />
            <TextView
                android:layout_width="0dp"
                android:layout_weight="5"
                android:text=":"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_gravity="center"
                android:textColor="@color/kfg_orange"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/farmer_address"
                android:layout_width="0dp"
                android:layout_weight="60"
                android:text=""
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_gravity="center"
                android:textColor="@color/black"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="100"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:paddingTop="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_weight="35"
                android:text="Latitude"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_gravity="center"
                android:textColor="@color/kfg_orange"
                android:layout_height="wrap_content" />

            <TextView
                android:layout_width="0dp"
                android:layout_weight="5"
                android:text=":"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_gravity="center"
                android:textColor="@color/kfg_orange"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/lat_text"
                android:layout_width="0dp"
                android:layout_weight="60"
                android:text=""
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@android:color/black"
                android:layout_height="match_parent"
                android:gravity="start"
                />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="100"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:paddingTop="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_weight="35"
                android:text="Longitude"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_gravity="center"
                android:textColor="@color/kfg_orange"
                android:layout_height="wrap_content" />

            <TextView
                android:layout_width="0dp"
                android:layout_weight="5"
                android:text=":"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_gravity="center"
                android:textColor="@color/kfg_orange"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/long_text"
                android:layout_width="0dp"
                android:layout_weight="60"
                android:text=""
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@android:color/black"
                android:layout_height="match_parent"
                android:gravity="start"
                />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="100"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:layout_marginTop="20dp">

            <org.osmdroid.views.MapView
                android:id="@+id/map"
                android:layout_width="match_parent"
                android:layout_height="300dp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="100"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:paddingTop="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_weight="35"
                android:text="Village /Road No"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_gravity="center"
                android:textColor="@color/kfg_orange"
                android:layout_height="wrap_content" />
            <TextView
                android:layout_width="0dp"
                android:layout_weight="5"
                android:text=":"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_gravity="center"
                android:textColor="@color/kfg_orange"
                android:layout_height="wrap_content" />

            <EditText
                android:id="@+id/village_id"
                android:layout_width="0dp"
                android:layout_weight="50"
                android:textSize="15sp"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/black"
                android:textColor="@android:color/black">

            </EditText>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="100"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:paddingTop="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_weight="35"
                android:text="Post Office"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_gravity="center"
                android:textColor="@color/kfg_orange"
                android:layout_height="wrap_content" />
            <TextView
                android:layout_width="0dp"
                android:layout_weight="5"
                android:text=":"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_gravity="center"
                android:textColor="@color/kfg_orange"
                android:layout_height="wrap_content" />

            <EditText
                android:id="@+id/post_ofc_id"
                android:layout_width="0dp"
                android:layout_weight="50"
                android:textSize="15sp"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/black"
                android:textColor="@android:color/black">

            </EditText>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="100"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:paddingTop="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_weight="35"
                android:text="Post Code"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_gravity="center"
                android:textColor="@color/kfg_orange"
                android:layout_height="wrap_content" />
            <TextView
                android:layout_width="0dp"
                android:layout_weight="5"
                android:text=":"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_gravity="center"
                android:textColor="@color/kfg_orange"
                android:layout_height="wrap_content" />

            <EditText
                android:id="@+id/postcode_id"
                android:layout_width="0dp"
                android:layout_weight="50"
                android:textSize="15sp"
                android:inputType="number"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/black"
                android:textColor="@android:color/black">

            </EditText>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="100"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:paddingTop="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_weight="35"
                android:text="Thana"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_gravity="center"
                android:textColor="@color/kfg_orange"
                android:layout_height="wrap_content" />
            <TextView
                android:layout_width="0dp"
                android:layout_weight="5"
                android:text=":"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_gravity="center"
                android:textColor="@color/kfg_orange"
                android:layout_height="wrap_content" />

            <EditText
                android:id="@+id/thana_id"
                android:layout_width="0dp"
                android:layout_weight="50"
                android:textSize="15sp"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/black"
                android:textColor="@android:color/black">

            </EditText>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="100"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:paddingTop="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_weight="35"
                android:text="District"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_gravity="center"
                android:textColor="@color/kfg_orange"
                android:layout_height="wrap_content" />
            <TextView
                android:layout_width="0dp"
                android:layout_weight="5"
                android:text=":"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_gravity="center"
                android:textColor="@color/kfg_orange"
                android:layout_height="wrap_content" />

            <EditText
                android:id="@+id/district_id"
                android:layout_width="0dp"
                android:layout_weight="50"
                android:textSize="15sp"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/black"
                android:textColor="@android:color/black">

            </EditText>
        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:weightSum="1"
            android:layout_marginTop="50dp">

            <Button
                android:id="@+id/set_loc_btn_id"
                android:layout_width="150dp"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:layout_marginLeft="30dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="@color/kfg_orange"
                android:padding="10dp"
                android:text="Save"
                android:textStyle="bold"
                android:textAllCaps="true" />

        </LinearLayout>
    </LinearLayout>

</ScrollView>